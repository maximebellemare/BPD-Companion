{
  "expo": {
    "name": "BPD Companion",
    "slug": "bpd-companion",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bpd-companion",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FBFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.zh9wtiagi54193nc7wcvb",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "BPD Companion uses the microphone only when you choose voice input for Companion.",
        "NSSpeechRecognitionUsageDescription": "BPD Companion uses speech recognition only to transcribe what you choose to say into Companion.",
        "LSApplicationQueriesSchemes": [
          "tel",
          "sms",
          "mailto"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F8FBFF"
      },
      "package": "com.maximebellemare.bpdcompanion",
      "permissions": [
        "POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID"
      ],
      "versionCode": 14
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow BPD Companion to use the microphone when you choose voice input.",
          "speechRecognitionPermission": "Allow BPD Companion to transcribe voice input into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8FBFF"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b574bc9-3593-4dee-88e6-6bcbdb994641"
      }
    },
    "owner": "maximebellemare99",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4b574bc9-3593-4dee-88e6-6bcbdb994641"
    }
  }
}
