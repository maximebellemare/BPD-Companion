EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: where Supabase should send users after password reset links.
EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=bpd-companion://auth/sign-in

# RevenueCat public SDK keys. Add the app-specific keys from RevenueCat.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_ios_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_android_key
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=your_revenuecat_test_key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=BPD Companion Pro
EXPO_PUBLIC_REVENUECAT_MONTHLY_PRODUCT_ID=bpd_companion_monthly
EXPO_PUBLIC_REVENUECAT_YEARLY_PRODUCT_ID=bpd_companion_yearly
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default

# RevenueCat dashboard setup expected by the app:
# Entitlement ID: BPD Companion Pro
# Offering ID: default
# Monthly product: bpd_companion_monthly as the offering's monthly package
# Yearly product: bpd_companion_yearly as the offering's annual package
